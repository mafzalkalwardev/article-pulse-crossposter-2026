# Hashnode
HASHNODE_API_TOKEN=
HASHNODE_PUBLICATION_ID=

# dev.to
DEVTO_API_KEY=

# Local content and state
ARTICLES_DIR=articles
PUBLICATION_STATE_FILE=.article-publisher-state.json

# Independent Growth Mode (public GitHub profile data only)
GITHUB_USERNAME=mafzalkalwardev
GROWTH_MODE_ENABLED=false
GROWTH_AUTO_PUBLISH=false

# Optional AI-assisted intelligence (OpenAI-compatible endpoint)
INTELLIGENCE_PROVIDER_URL=
INTELLIGENCE_API_KEY=
INTELLIGENCE_MODEL=

# Encrypts local Hashnode and dev.to tokens before they are written to data/local-connections.json
APP_ENCRYPTION_KEY=

# Server-side publishing loop. Set to false to disable. The interval is 15 minutes.
PUBLISH_LOOP=true

# Optional overrides so a local run or test can target another Hashnode or dev.to API base
HASHNODE_ENDPOINT=
DEVTO_API_BASE=
